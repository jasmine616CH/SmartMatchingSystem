<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="module.supplier.mapper.SupplierQualificationMapper">

    <resultMap id="QualificationMap" type="module.supplier.vo.SupplierQualificationVO">
        <result property="qfId"         column="qf_id"/>
        <result property="supplierId"   column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="qfName"       column="qf_name"/>
        <result property="certNo"       column="cert_no"/>
        <result property="effectDate"   column="effect_date"/>
        <result property="expireDate"   column="expire_date"/>
        <result property="fileUrl"      column="file_url"/>
        <result property="status"       column="status"/>
        <result property="auditUserId"  column="audit_user_id"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateTime"   column="update_time"/>
    </resultMap>

    <select id="selectQualificationPage" resultMap="QualificationMap">
        SELECT
            q.qf_id,
            q.supplier_id,
            q.qf_name,
            q.cert_no,
            q.effect_date,
            q.expire_date,
            q.file_url,
            q.status,
            q.audit_user_id,
            q.create_time,
            q.update_time,
            s.supplier_name
        FROM supplier_qualification q
            LEFT JOIN supplier s ON s.supplier_id = q.supplier_id
        <where>
            <if test="dto.supplierId != null">
                AND q.supplier_id = #{dto.supplierId}
            </if>
            <if test="dto.qfName != null and dto.qfName != ''">
                AND q.qf_name LIKE CONCAT('%', #{dto.qfName}, '%')
            </if>
            <if test="dto.certNo != null and dto.certNo != ''">
                AND q.cert_no LIKE CONCAT('%', #{dto.certNo}, '%')
            </if>
            <!--
                状态筛选须翻译「派生状态」：
                3-过期 库里并不存在，等价于「已通过审核 且 已过失效日期」；
                2-有效 则要反过来排除已过期的，否则会把过期证书也算作有效。
                这是派生状态唯一泄漏进查询的地方。
            -->
            <choose>
                <when test="dto.status != null and dto.status == 3">
                    AND q.status = 2
                    AND q.expire_date &lt; CURDATE()
                </when>
                <when test="dto.status != null and dto.status == 2">
                    AND q.status = 2
                    AND q.expire_date &gt;= CURDATE()
                </when>
                <when test="dto.status != null">
                    AND q.status = #{dto.status}
                </when>
            </choose>
        </where>
        ORDER BY q.qf_id DESC
    </select>

</mapper>

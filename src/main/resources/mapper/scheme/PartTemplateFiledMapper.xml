<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="module.scheme.mapper.ParamTemplateFieldMapper">

    <select id="selectByTemplateIds" resultType="module.scheme.entity.ParamTemplateField">
        SELECT * FROM ugvc_db.param_template_field
        WHERE template_id IN
        <foreach collection="templateIds" item="templateIds" open="(" close=")" separator=",">
            #{templateIds}
        </foreach>
    </select>

</mapper>
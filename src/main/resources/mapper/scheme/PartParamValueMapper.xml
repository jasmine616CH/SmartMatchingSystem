<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="module.scheme.mapper.PartParamValueMapper">

    <select id="selectByPartIds" resultType="module.scheme.entity.PartParamValue">
        SELECT * FROM ugvc_db.part_param_value
        WHERE part_id IN
        <foreach collection="partIds" item="partId" open="(" close=")" separator=",">
            #{partId}
        </foreach>
    </select>

</mapper>
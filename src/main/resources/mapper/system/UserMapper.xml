<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="module.system.mapper.SysUserMapper">

    <!-- sys_role 的角色编码列是 role_code，不是 role_key -->
    <select id="selectRoleKeysByUserId" resultType="String"> SELECT r.role_code FROM sys_user_role ur
        INNER JOIN sys_role r ON ur.role_id = r.role_id WHERE ur.user_id = #{userId} </select>

</mapper>